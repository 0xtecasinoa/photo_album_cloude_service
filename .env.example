# --- Database ---
DATABASE_URL="postgresql://cpc:cpc_dev_password@localhost:5432/construction_photo_cloud"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-char-minimum-random-string"
AUTH_URL="http://localhost:3000"

# --- Object storage (MinIO locally) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-northeast-1"
S3_BUCKET="construction-photos"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# --- Limits ---
MAX_UPLOAD_BYTES="52428800"

# --- Optional: handwritten 看板 OCR ---
ANTHROPIC_API_KEY=""
