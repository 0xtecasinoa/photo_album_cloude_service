# --- Database ---
# 開発時は `npm run dev:db` で PostgreSQL（PGlite）を起動できます。Docker は不要です。
# 本番では通常の PostgreSQL の接続先を指定してください。
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# 接続プールの上限。dev:db は同時接続が1本までのため、開発時は 1 のままにします。
# DB_POOL_MAX="1"

# --- Auth ---
# 生成: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-char-minimum-random-string"
AUTH_URL="http://localhost:3000"

# --- Google ログイン（任意）---
# 両方を設定したときだけ、ログイン画面に Google のボタンが出ます。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- ファイル保存 ---
# 既定ではローカルディスクに保存します（追加のサービスは不要）。
STORAGE_DIR="./.storage"

# S3（または S3 互換ストレージ）を使う場合のみ、以下をすべて設定してください。
# 設定されている場合は、保存先が自動的に S3 に切り替わります。
# S3_ENDPOINT="https://s3.ap-northeast-1.amazonaws.com"
# S3_REGION="ap-northeast-1"
# S3_BUCKET="construction-photos"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"

# --- 上限 ---
MAX_UPLOAD_BYTES="52428800"

# --- 手書き看板 OCR（任意）---
ANTHROPIC_API_KEY=""
